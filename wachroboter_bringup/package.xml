<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wachroboter_bringup</name>
  <version>0.1.0</version>
  <description>Launch- und Parameter-Dateien fuer das Wachroboter-Projekt (echter Betrieb und Simulation).</description>
  <maintainer email="atze@example.com">Atze</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- exec_depend = wird nur zur LAUFZEIT gebraucht (die Launch-Dateien
       starten diese Pakete). Nichts davon wird hier kompiliert. -->
  <exec_depend>guard_robot</exec_depend>
  <exec_depend>visitor_robot</exec_depend>
  <exec_depend>fake_robot</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
